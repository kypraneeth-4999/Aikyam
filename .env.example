# Copy to .env.local and fill in. Never commit real secrets.
# See docs/EXTERNAL-SETUP.md for where each value comes from.

# ── Supabase ───────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Platform fee (JAD §1.5 — organizer-absorbed, configurable) ──
# Basis points. 500 = 5.00%. Read via src/config/app.ts, never hard-coded.
PLATFORM_FEE_BPS=500

# ── Razorpay (Slice 3) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (Slice 4) ───────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=

# ── QR ticket signing (Slice 3) ────────────────────────────
# Secret for signing single-use ticket JWTs.
QR_JWT_SECRET=

# ── Email (Slice 4 — ticket delivery via Resend) ───────────
RESEND_API_KEY=
EMAIL_FROM=Aikyam <onboarding@resend.dev>

